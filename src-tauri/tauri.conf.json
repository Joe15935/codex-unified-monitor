{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Unified Monitor",
  "version": "0.2.1",
  "identifier": "com.joe15935.codex-unified-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1428",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Unified Monitor",
        "width": 1240,
        "height": 860,
        "minWidth": 850,
        "minHeight": 600,
        "visible": true
      },
      {
        "label": "compact",
        "title": "Codex Monitor",
        "url": "index.html?compact=1",
        "width": 370,
        "height": 470,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Read-only Codex usage and quota monitor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "../licenses/*",
      "../THIRD_PARTY_NOTICES.md",
      "../LICENSE"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
